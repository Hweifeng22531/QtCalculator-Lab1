        <property name="styleSheet">
         <string notr="true">/* 显示框美化 */
QLineEdit#displayEdit {
    background-color: #f8f8f8;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 10px;
    font-size: 28px;
    color: #222;
}

/* 按钮通用样式 */
QPushButton {
    min-height: 48px;
    border-radius: 6px;
    border: 1px solid #d0d0d0;
    background-color: #f0f0f0;
    font-size: 16px;
}
QPushButton:hover { background-color: #e0e0e0; }
QPushButton:pressed { background-color: #c8c8c8; }

/* 运算符和等号高亮 */
QPushButton#btn_add, QPushButton#btn_sub,
QPushButton#btn_mul, QPushButton#btn_div,
QPushButton#btn_equal {
    background-color: #4a90e2;
    color: white;
    border-color: #3a80d2;
}
QPushButton#btn_add:hover, QPushButton#btn_sub:hover,
QPushButton#btn_mul:hover, QPushButton#btn_div:hover,
QPushButton#btn_equal:hover {
    background-color: #5aa0f2;
}</string>
